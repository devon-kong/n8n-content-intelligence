    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const resp = items[0]?.json || {};\nif (resp.code !== undefined && resp.code !== 0) {\n  throw new Error('飞书 Pipeline Config 查询失败：' + JSON.stringify(resp).slice(0, 500));\n}\nconst records = resp.data?.items || [];\nif (records.length === 0) {\n  throw new Error('pipeline_key=benchmark 未找到启用的配置（0 条记录）');\n}\nif (records.length > 1) {\n  throw new Error('pipeline_key=benchmark 配置存在多条记录（' + records.length + '），应唯一');\n}\nfunction fsText(v) {\n  if (v === null || v === undefined) return '';\n  if (Array.isArray(v)) return v.map(x => x?.text || '').join('').trim();\n  if (typeof v === 'object') return (v.text || v.link || '').trim();\n  return String(v).trim();\n}\nconst fields = records[0].fields || {};\nconst cfg = {\n  pipeline_key: 'benchmark',\n  target_base: fsText(fields.target_base),\n  target_table: fsText(fields.target_table),\n  window_days: Number(fsText(fields.window_days)) || 7,\n  summary_enabled: Boolean(fields.summary_enabled),\n  metric_enabled: Boolean(fields.metric_enabled),\n  process_mode: fsText(fields.process_mode),\n  summary_prompt: fsText(fields.summary_prompt),\n  summary_version: fsText(fields.summary_version),\n  model: fsText(fields.model),\n};\nif (!cfg.target_base) throw new Error('target_base 为空，请检查飞书配置');\nif (!cfg.target_table) throw new Error('target_table 为空，请检查飞书配置');\nreturn [{ json: cfg }];"
      },
