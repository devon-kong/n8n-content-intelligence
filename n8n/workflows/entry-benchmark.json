        "body": "={{ JSON.stringify({ field_names: ['pipeline_key', 'target_base', 'target_table', 'window_days', '是否启用', 'summary_enabled', 'metric_enabled', 'process_mode', 'summary_prompt', 'summary_version', 'model'], filter: { conjunction: 'and', conditions: [{ field_name: 'pipeline_key', operator: 'is', value: ['benchmark'] }, { field_name: '是否启用', operator: 'is', value: [true] }] }, page_size: 1 }) }}"
      },
      "id": "ciEntryBench001-n03",
